{
  "dataset": {
    "seed": 42,
    "rows": 1000,
    "tenant_split": { "acme": 0.45, "beta": 0.35, "gamma": 0.2 },
    "poisoned_fraction": 0.015
  },
  "db": {
    "max_result_rows": 200,
    "query_timeout_ms": 2000,
    "max_sql_length": 50000,
    "max_expr_depth": 100,
    "max_compound_select": 20,
    "max_vdbe_ops": 25000,
    "max_like_pattern_length": 1000
  },
  "analytics": {
    "histogram_bins": 10,
    "max_histogram_bins": 50,
    "max_scan_rows": 5000
  },
  "agent": {
    "model": "huihui_ai/qwen3-abliterated:30b-a3b",
    "embed_model": "nomic-embed-text",
    "max_tool_retries": 3,
    "max_tool_iterations": 6,
    "max_output_tokens": 4096,
    "context_window": 16384,
    "turn_deadline_s": 120.0,
    "thinking": true,
    "duration_decimals": 2,
    "prompt_guardrails": true
  },
  "browse": {
    "page_size": 25,
    "max_filter_chars": 100,
    "max_search_hits": 25
  },
  "rag": {
    "top_k": 5,
    "embed_batch_size": 64,
    "embed_timeout_s": 120
  },
  "auth": {
    "token_ttl_minutes": 120,
    "refresh_within_minutes": 30
  },
  "conversations": {
    "title_max_chars": 80,
    "generated_title_max_words": 6,
    "generated_title_max_chars": 48,
    "generated_title_reject_chars": 200,
    "title_timeout_s": 20.0,
    "max_turn_events": 200,
    "max_turn_payloads": 6,
    "max_reasoning_chars": 4000,
    "max_history_turns": 20
  },
  "api": {
    "models_timeout_s": 5.0,
    "default_title": "New conversation"
  }
}
